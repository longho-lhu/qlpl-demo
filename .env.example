# SQLite database file name, stored under ./data
SQLITE_DB_FILE=qlpl.db

# Public base URL used by the axios client (browser-exposed)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# App domain, useful for absolute links / CORS
APP_DOMAIN=http://localhost:3000

# Secret used to sign JWT auth tokens - generate a unique value per environment
JWT_SECRET=

# Add other secret keys (API keys, etc.) below - never commit real values
# EXAMPLE_API_KEY=
